# Zalo PC app — mẫu .env (copy thành .env cạnh docker-compose.yml). TẤT CẢ đều KHÔNG bắt buộc:
# biến để trống hoặc không có thì app dùng mặc định / tự sinh, `docker compose up` không báo lỗi.

# Tài khoản đăng nhập app. Để trống: app tự sinh (user "admin", mật khẩu ngẫu nhiên) lần đầu, in một lần trong log
# và lưu ở /data/THONG-TIN-DANG-NHAP.txt. Sau đó đổi được trong WebUI hoặc dịch vụ HA zalo_call.set_app_password.
ZALO_PC_APP_USER=
ZALO_PC_APP_PASSWORD=
# Thay cho PASSWORD: hash tính sẵn (python3 -m zalo_pc_app.app_auth). Đặt hash thì KHÔNG đổi được mật khẩu từ WebUI/HA.
# ZALO_PC_APP_PASSWORD_HASH=

# Webhook sang Home Assistant (chỉ dùng khi CHƯA có cấu hình; WebUI / HA / dịch vụ đã đặt thì không bị đè).
# Tích hợp HA tự điền địa chỉ này khi để trống, nên thường KHÔNG cần đặt. Một địa chỉ cho cả bốn loại:
ZALO_PC_WEBHOOK_URL=
# hoặc từng loại: ZALO_PC_WEBHOOK_MESSAGE_URL, ZALO_PC_WEBHOOK_GROUP_EVENT_URL, ZALO_PC_WEBHOOK_REACTION_URL, ZALO_PC_WEBHOOK_CALL_URL

# Tắt WebUI trên bản có giao diện (bản :noui không có giao diện sẵn, không cần biến này): ZALO_PC_UI=0
# ZALO_PC_APP_SESSION_HOURS=8
